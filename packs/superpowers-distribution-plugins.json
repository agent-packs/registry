{
  "id": "superpowers-distribution-plugins",
  "name": "Superpowers Distribution Plugins Pack",
  "version": "0.2.0",
  "description": "Pinned Superpowers plugin and extension descriptors for Claude Code, Codex, Cursor, Gemini CLI, and OpenCode, plus portable skill installation for Copilot.",
  "license": "MIT",
  "maintainers": [
    "sandeshh"
  ],
  "stability": "stable",
  "lastVerified": "2026-07-25",
  "reviewStatus": "verified",
  "trust": "community",
  "compatibility": {
    "codex": {
      "status": "verified",
      "lastVerified": "2026-07-25",
      "notes": "The pinned Codex plugin descriptor resolves safely and remains reference-only unless explicitly installed."
    },
    "claude-code": {
      "status": "verified",
      "lastVerified": "2026-07-25",
      "notes": "The pinned Claude Code plugin descriptor resolves safely and remains reference-only unless explicitly installed."
    },
    "cursor": {
      "status": "compatible",
      "lastVerified": "2026-07-25",
      "notes": "The pinned Cursor plugin descriptor is compatible; native installation remains agent-managed."
    },
    "gemini": {
      "status": "compatible",
      "lastVerified": "2026-07-25",
      "notes": "The pinned Gemini extension descriptor is compatible; native installation remains agent-managed."
    },
    "opencode": {
      "status": "compatible",
      "lastVerified": "2026-07-25",
      "notes": "The pinned OpenCode installation descriptor is compatible; native installation remains agent-managed."
    },
    "copilot": {
      "status": "compatible",
      "lastVerified": "2026-07-25",
      "notes": "Copilot consumes the portable skills from the parent suite; no separate upstream plugin descriptor is claimed."
    }
  },
  "requirements": {
    "agentPacks": ">=0.1.0",
    "tools": {
      "codex": "latest",
      "claude-code": "latest",
      "cursor": "latest",
      "gemini": "latest",
      "opencode": "latest",
      "copilot": "latest"
    }
  },
  "useCases": [
    "Install the Superpowers skill library through the native plugin or extension for your coding agent.",
    "Track immutable Superpowers distribution descriptors for Claude Code, Codex, Cursor, Gemini CLI, and OpenCode.",
    "Use the parent suite's portable skill path for Copilot without claiming a native plugin that upstream does not publish."
  ],
  "examplePrompts": [
    "Install the Superpowers plugin for my editor from this pack and confirm its skills are available."
  ],
  "tags": [
    "superpowers",
    "plugins",
    "claude-code",
    "codex",
    "cursor",
    "gemini",
    "opencode",
    "copilot"
  ],
